# 이 파일을 `.env` 로 복사한 뒤 값을 채운다 (`cp .env.example .env`).
# `.env` 는 .gitignore 대상 — 절대 커밋하지 않는다.
# 프로덕션은 별도의 `.env.prod` 를 쓴다 (scripts/deploy.sh 가 EC2 로 scp).
# 백엔드는 pydantic-settings 로 읽는다 — backend/app/config.py 의
# Settings 필드명(소문자)이 여기 대문자 키에 1:1 대응한다.

DATABASE_URL=postgresql+asyncpg://reinsai:reinsai@postgres:5432/reinsai
# docker-compose 가 postgres 컨테이너 비밀번호로 쓴다.
POSTGRES_PASSWORD=
GEMINI_API_KEY=your-gemini-api-key-here

# ins/chat 코파일럿 (Anthropic Claude + L3 온톨로지 그라운딩).
# 비우면 채팅만 비활성 안내를 내고 나머지 백엔드는 정상 동작한다.
ANTHROPIC_API_KEY=
ARIA_CHAT_MODEL=claude-opus-5
ARIA_CHAT_EFFORT=high

# '+ 알파렌즈' 외부 툴 (argo alpha-lenz MCP 서버). URL 이 비면 토글이 켜져도
# 내부 툴만 쓴다. 토큰은 선택 — 현재 서버는 미인증도 허용.
ARGO_MCP_URL=https://api.alpha-lenz.com/mcp/
ARGO_MCP_TOKEN=

# ARIA landing contact form — sends to Resend (email) and/or Slack (webhook)
# in parallel. The form succeeds if at least one channel succeeds; both blank
# leaves the form on a "configure later" error without crashing the server.
RESEND_API_KEY=
RESEND_FROM="ARIA <onboarding@resend.dev>"
CONTACT_EMAIL=henry@treasurer.co.kr
SLACK_WEBHOOK_URL=

# Stable Server Action encryption key — generate ONCE with `openssl rand -base64 32`.
# Required so users with an open tab can still submit the form after a redeploy
# (without this Next.js regenerates action IDs on every build).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# 뉴스 인사이트 툴 (/api/tools/news). 글로벌은 Perigon, 국내는 Naver 검색 API.
# 비우면 해당 툴만 "missing" 헬스 상태를 보고하고 나머지 백엔드는 정상 동작한다.
PERIGON_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 만족도 설문(/survey) 결과 조회 API 의 비밀번호. 반드시 설정할 것 —
# 미설정 시 backend/app/routers/survey.py 의 fallback 값이 쓰인다.
SURVEY_RESULTS_PASSWORD=

# 쓰기 가능 저장소 경로. compose 가 주입하므로 로컬에선 보통 불필요.
# WEEKLY_STORE_DIR=/app/weekly-data
# OPS_STORE_DIR=/app/ops-data
# NEWS_STORE_DIR=/app/news-data
# BD_NEWS_STORE_DIR=/app/news-data
# SURVEY_STORE_DIR=/app/survey-data

# KB 결정론적 파서 게이트. off | shadow | on (기본 off).
# on 은 KB_PARSER_ON_APPROVED 동반 필수 — 미설정이면 기동 시 즉시 실패한다.
# KB_PARSER_MODE=off
# KB_PARSER_ON_APPROVED=
